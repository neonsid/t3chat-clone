# Created automatically by `pnpm convex:dev`.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side AI provider keys. OpenAI and Google are direct; other chat
# providers are routed through OpenRouter.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Set these in the Convex dashboard (npx convex env set ...), not only here.
# OPENAI_API_KEY is also required in Convex for AI thread titles.
CLERK_JWT_ISSUER_DOMAIN=

# Cloudflare R2 (S3-compatible) — set in Convex dashboard only. Never expose as
# VITE_* and do not set a public base URL in v1 (private bucket + signed GETs).
# Used by @convex-dev/r2. Prefer R2_ENDPOINT; R2_ACCOUNT_ID is a fallback that
# builds https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com.
# R2_ENDPOINT=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
#
# Bucket setup checklist:
# - Private bucket (e.g. t3chat-attachments); token scoped to that bucket only
# - CORS: exact app origins; methods PUT/GET/HEAD; ExposeHeaders ETag;
#   AllowedHeaders must cover Content-Type and any checksum headers the browser
#   sends with AWS-signed PUT (verify with Chromium + ky)
# - Lifecycle rule on abandoned prefixes with retention longer than app GC
#   (ATTACHMENT_UNBOUND_TTL_MS in convex/attachmentConstants.ts)
